# Puerto del servidor backend (Render/Railway/Heroku lo asignan automáticamente)
PORT=3001

# URL pública de tu aplicación en producción (Ej: https://tu-agendamiento.onrender.com)
APP_URL=http://localhost:3001

# Credenciales de Google Cloud (Opcionales si ya las tienes guardadas en settings.json)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
